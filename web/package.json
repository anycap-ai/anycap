{
  "name": "anycap-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:seo-routes": "node ./scripts/generate-seo-route-manifest.mjs",
    "generate:localized-seo-pages": "node ./scripts/generate-localized-seo-pages.mjs",
    "sync:seo-locales": "pnpm run generate:seo-routes && pnpm run generate:localized-seo-pages",
    "dev": "pnpm run sync:seo-locales && next dev --turbopack",
    "check:edge-runtime": "node ./scripts/ensure-edge-runtime.mjs",
    "check:seo-breadcrumbs": "node ./scripts/check-seo-breadcrumbs.mjs",
    "check:seo-locale-rollout": "node ./scripts/check-seo-locale-rollout.mjs",
    "check:seo-hub-locale-rollout": "node ./scripts/check-seo-hub-locale-rollout.mjs",
    "check:seo-ia": "node ./scripts/check-seo-information-architecture.mjs",
    "check:model-hub": "node --test ./scripts/model-hub.test.mjs ./scripts/models-hub-page.test.mjs",
    "test:agent-core": "node --import tsx --test ./scripts/agent-core-*.test.mjs",
    "test:seo-foundation": "node --test ./scripts/check-seo-locale-rollout.test.mjs ./scripts/generate-sitemap-lastmod.test.mjs ./scripts/next-metadata-head.test.mjs ./scripts/legacy-route-redirects.test.mjs",
    "check:seo-p0-locales": "node ./scripts/check-seo-locale-rollout.mjs --locales=pt-br,id,de --paths=/for/codex,/capabilities/video-generation,/capabilities/video-analysis,/guides/how-to-add-video-generation-to-ai-agent --strict",
    "check:seo-p0-contracts": "node ./scripts/check-main-site-seo-p0.mjs",
    "check:seo-p0": "pnpm run test:seo-foundation && pnpm run check:seo-p0-locales && pnpm run check:seo-p0-contracts",
    "generate:sitemap-lastmod": "node ./scripts/generate-sitemap-lastmod.mjs",
    "publish:indexnow": "node ./scripts/publish-indexnow.mjs",
    "build": "pnpm run sync:seo-locales && pnpm run check:model-hub && pnpm run check:edge-runtime && pnpm run check:seo-breadcrumbs && pnpm run check:seo-ia && pnpm run check:seo-locale-rollout && pnpm run check:seo-hub-locale-rollout && pnpm run check:seo-p0 && pnpm run generate:sitemap-lastmod && next build",
    "build:cf": "pnpm run sync:seo-locales && pnpm run check:model-hub && pnpm run check:seo-breadcrumbs && pnpm run check:seo-ia && pnpm run check:seo-locale-rollout && pnpm run check:seo-hub-locale-rollout && pnpm run check:seo-p0 && pnpm run generate:sitemap-lastmod && node ./scripts/pages-build.mjs && pnpm run publish:indexnow",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.16.0",
    "@gsap/react": "2.1.2",
    "@next/third-parties": "^16.2.2",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "geist": "^1.7.0",
    "gsap": "3.15.0",
    "marked": "^17.0.5",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "swr": "^2.4.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.1",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5",
    "wrangler": "^4.80.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "next@15.5.14": "patches/next@15.5.14.patch"
    }
  }
}
