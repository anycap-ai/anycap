stateDiagram-v2
    [*] --> capability_panel
    capability_panel --> capability_form: select capability
    capability_form --> loading: submit
    loading --> result_success: API success
    loading --> result_error: API error
    result_success --> capability_form: new / retry
    result_error --> capability_form: retry
    result_success --> capability_panel: close
    result_error --> capability_panel: close
    capability_panel --> settings: click settings
    settings --> capability_panel: back
    capability_panel --> history: click history
    history --> capability_panel: back
    history --> capability_form: reuse
