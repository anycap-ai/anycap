ANYCAP_APP_NAME=anycap-server
ANYCAP_APP_ENV=dev
ANYCAP_HTTP_ADDR=:8080
ANYCAP_RUNTIME_MODE=dev
ANYCAP_LOG_OUTPUT=stdout,/var/log/kntech/anycap-server/app.log
ANYCAP_RATE_LIMIT_RPM=60
ANYCAP_LOGIN_API_KEY_TTL=168h

# Capability rate limit
# Default: all capability-limited function routes use ANYCAP_RATE_LIMIT_RPM.
# Set ANYCAP_RATE_LIMIT_DCONF_ENABLED=true to load rate limits from dconf first.
# When dconf is enabled, AnyCap uses ANYCAP_RATE_LIMIT_DCONF_GROUP / DATA_ID and falls back to env values if dconf init/load fails.
# DCONF_NACOS_HOST / DCONF_NACOS_NAMESPACE are provided by the common-go dconf client environment.
# Override a specific capability with ANYCAP_RATE_LIMIT_<CAPABILITY>_RPM.
# Capability name mapping: image.generate -> ANYCAP_RATE_LIMIT_IMAGE_GENERATE_RPM
# See docs/config/server-rate-limit.md for the full route/capability/env mapping table.
ANYCAP_RATE_LIMIT_DCONF_ENABLED=true
ANYCAP_RATE_LIMIT_DCONF_GROUP=anycap
ANYCAP_RATE_LIMIT_DCONF_DATA_ID=rate_limit
DCONF_NACOS_HOST=mse-f87f74a10-nacos-ans.mse.aliyuncs.com
DCONF_NACOS_PORT=8848
DCONF_NACOS_NAMESPACE=infra-dev
DCONF_NACOS_CONTEXT_PATH=/nacos
DCONF_NACOS_TIMEOUT_MS=5000
# ANYCAP_RATE_LIMIT_IMAGE_GENERATE_RPM=10
# ANYCAP_RATE_LIMIT_VIDEO_GENERATE_RPM=5
# ANYCAP_RATE_LIMIT_IMAGE_READ_RPM=30
# ANYCAP_RATE_LIMIT_DRIVE_BROWSE_RPM=120
# ANYCAP_RATE_LIMIT_PAGE_PUBLISH_RPM=12

# Feature access dconf
# Set ANYCAP_FEATURE_DCONF_ENABLED=true to load feature access policy from dconf first.
# When enabled, AnyCap uses ANYCAP_FEATURE_DCONF_GROUP / DATA_ID and falls back to server defaults + ANYCAP_FEATURE_* if dconf init/load fails.
ANYCAP_FEATURE_DCONF_ENABLED=true
ANYCAP_FEATURE_DCONF_GROUP=anycap
ANYCAP_FEATURE_DCONF_DATA_ID=feature_access

# Postgres
ANYCAP_PG_HOST=<dev-postgres-host>
ANYCAP_PG_PORT=5432
ANYCAP_PG_USER=<dev-postgres-user>
ANYCAP_PG_PASSWORD=<dev-postgres-password>
ANYCAP_PG_DATABASE=postgres
ANYCAP_PG_SSL_MODE=prefer
ANYCAP_PG_TIMEZONE=UTC
ANYCAP_PG_AUTO_MIGRATE=true

# Redis
ANYCAP_REDIS_HOST=<dev-redis-host>
ANYCAP_REDIS_PORT=6379
ANYCAP_REDIS_USERNAME=default
ANYCAP_REDIS_PASSWORD=<dev-redis-password>
ANYCAP_REDIS_DB=0

# Drive/Page shared auth + edge host
ANYCAP_PASSWORD_PEPPER=<strong-random-pepper>
ANYCAP_DRIVE_SHARE_BASE_URL=https://drive.anycap.dev/s
ANYCAP_PAGE_HOST_FORMAT=page-%s.anycap.dev

# Capability output artifact
ANYCAP_ARTIFACT_PUBLIC_BASE_URL=https://artifact.anycap.dev
ANYCAP_ARTIFACT_INGEST_BASE_URL=https://artifact-ingest.anycap.dev
ANYCAP_ARTIFACT_INGEST_TOKEN=<artifact-ingest-token>
ANYCAP_ARTIFACT_LINK_TTL_SECONDS=600

# Cloud object storage (R2 via S3-compatible API)
ANYCAP_CLOUD_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
ANYCAP_CLOUD_S3_ACCESS_KEY_ID=<r2-access-key-id>
ANYCAP_CLOUD_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
ANYCAP_CLOUD_S3_BUCKET=anycap-cloud-dev
ANYCAP_CLOUD_S3_REGION=auto
ANYCAP_CLOUD_S3_PRESIGN_EXPIRY_SECONDS=600
ANYCAP_CLOUD_S3_PRESIGN_GET_EXPIRY_SECONDS=3600
ANYCAP_CLOUD_S3_FORCE_PATH_STYLE=true

# Usage sync (poll NexusHub get_submit_result to backfill final status/cost)
ANYCAP_USAGE_SYNC_ENABLED=true
ANYCAP_USAGE_SYNC_POLL_INTERVAL=1m
ANYCAP_USAGE_SYNC_BATCH_SIZE=50

# KV sync (required for worker-facing Drive/Page edge data)
ANYCAP_KVSYNC_ENABLED=true
ANYCAP_KVSYNC_WAIT_ENABLED=true
ANYCAP_KVSYNC_POLL_INTERVAL=1s
ANYCAP_KVSYNC_LOCK_TTL=5m
ANYCAP_KVSYNC_WAIT_TIMEOUT=5s

# Cloudflare KV API
ANYCAP_CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
ANYCAP_CLOUDFLARE_KV_NAMESPACE_ID=<cloudflare-kv-namespace-id>
ANYCAP_CLOUDFLARE_API_TOKEN=<cloudflare-api-token>
ANYCAP_CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# Auth0
ANYCAP_AUTH0_ENABLED=false
ANYCAP_AUTH0_ISSUER=https://<tenant>.auth0.com/
ANYCAP_AUTH0_AUDIENCE=https://api.anycap.dev
ANYCAP_AUTH0_REDIRECT_URL=http://127.0.0.1:14565/callback

# Credit
ANYCAP_CREDIT_BASE_URL=<credit-base-url>
ANYCAP_CREDIT_BIZ_TOKEN=<credit-biz-token>
ANYCAP_CREDIT_TIMEOUT_SECONDS=10
ANYCAP_CREDIT_SIGNUP_REWARD_ENABLED=false
ANYCAP_CREDIT_SIGNUP_REWARD_PACKAGE_TYPE=REWARD
ANYCAP_CREDIT_SIGNUP_REWARD_PACKAGE_SUBTYPE=SIGNUP_BONUS

# Optional alerts
ANYCAP_LARK_MSG_API=https://lark-msg-wmvfpeppfl.ap-southeast-1-vpc.fcapp.run/v1/send
ANYCAP_LARK_WEBHOOK_URL=<lark-webhook-url>
ANYCAP_LARK_WEBHOOK_SECRET=<lark-webhook-secret>
