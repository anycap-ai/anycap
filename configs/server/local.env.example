ANYCAP_APP_NAME=anycap-server
ANYCAP_APP_ENV=local
ANYCAP_HTTP_ADDR=:8080
ANYCAP_RUNTIME_MODE=dev
ANYCAP_LOGIN_API_KEY_TTL=168h
ANYCAP_RATE_LIMIT_RPM=60

# Postgres (local via `make infra-up`)
ANYCAP_PG_HOST=127.0.0.1
ANYCAP_PG_PORT=15432
ANYCAP_PG_USER=anycap
ANYCAP_PG_PASSWORD=anycap
ANYCAP_PG_DATABASE=anycap
ANYCAP_PG_SSL_MODE=disable
ANYCAP_PG_TIMEZONE=UTC
ANYCAP_PG_AUTO_MIGRATE=true

# Redis (local via `make infra-up`)
ANYCAP_REDIS_ADDR=127.0.0.1:16379

# Drive/Page shared auth
ANYCAP_PASSWORD_PEPPER=<strong-random-pepper>
ANYCAP_DRIVE_SHARE_BASE_URL=https://drive.anycap.cloud/s
ANYCAP_PAGE_HOST_SUFFIX=.page.anycap.cloud

# Optional local-only auth bypass for manual API testing
ANYCAP_BYPASS_AUTH_FOR_LOCAL_TEST=true
ANYCAP_BYPASS_AUTH_USER_ID=123

# Agent Platform (Capabilities Provider)
AGENT_PLATFORM_BASE_URL=https://agent-platform.dev.knoffice.tech
AGENT_PLATFORM_API_KEY=<agent-platform-api-key>
AGENT_PLATFORM_TENANT_ID=anycap
AGENT_PLATFORM_TIMEOUT_SECONDS=300

# NexusHub
NEXUSHUB_BASE_URL=<nexushub-base-url>
NEXUSHUB_TOKEN=<nexushub-token>

# Object Storage (S3-compatible)
ANYCAP_CLOUD_S3_ENDPOINT=<s3-endpoint>
ANYCAP_CLOUD_S3_ACCESS_KEY_ID=<s3-access-key-id>
ANYCAP_CLOUD_S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
ANYCAP_CLOUD_S3_BUCKET=anycap-cloud-dev
ANYCAP_CLOUD_S3_REGION=auto
ANYCAP_CLOUD_S3_PRESIGN_EXPIRY_SECONDS=600
ANYCAP_CLOUD_S3_PRESIGN_GET_EXPIRY_SECONDS=3600
ANYCAP_CLOUD_S3_FORCE_PATH_STYLE=true

# Optional KV sync (required if you need worker-facing Drive/Page edge data)
ANYCAP_KVSYNC_ENABLED=false
ANYCAP_KVSYNC_WAIT_ENABLED=true
ANYCAP_KVSYNC_POLL_INTERVAL=1s
ANYCAP_KVSYNC_LOCK_TTL=5m
ANYCAP_KVSYNC_WAIT_TIMEOUT=5s

# Cloudflare KV API (used when ANYCAP_KVSYNC_ENABLED=true)
ANYCAP_CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
ANYCAP_CLOUDFLARE_KV_NAMESPACE_ID=<cloudflare-kv-namespace-id>
ANYCAP_CLOUDFLARE_API_TOKEN=<cloudflare-api-token>
ANYCAP_CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# Lark Webhook (alerts)
ANYCAP_LARK_MSG_API=https://lark-msg-wmvfpeppfl.ap-southeast-1-vpc.fcapp.run/v1/send
ANYCAP_LARK_WEBHOOK_URL=<lark-webhook-url>
ANYCAP_LARK_WEBHOOK_SECRET=<lark-webhook-secret>

# Optional Auth0 override for local integration testing
ANYCAP_AUTH0_ENABLED=false
ANYCAP_AUTH0_ISSUER=https://<tenant>.auth0.com/
ANYCAP_AUTH0_AUDIENCE=https://api.anycap.local
ANYCAP_AUTH0_CLIENT_ID=<auth0-client-id>
ANYCAP_AUTH0_CLIENT_SECRET=<auth0-client-secret>
ANYCAP_AUTH0_REDIRECT_URL=http://127.0.0.1:14565/callback

# Optional Credit override for local integration testing
ANYCAP_CREDIT_BASE_URL=<credit-base-url>
ANYCAP_CREDIT_BIZ_TOKEN=<credit-biz-token>
ANYCAP_CREDIT_TIMEOUT_SECONDS=10
ANYCAP_CREDIT_SIGNUP_REWARD_PACKAGE_TYPE=REWARD
ANYCAP_CREDIT_SIGNUP_REWARD_PACKAGE_SUBTYPE=SIGNUP_BONUS
