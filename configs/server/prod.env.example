ANYCAP_APP_NAME=anycap-server
ANYCAP_APP_ENV=prod
ANYCAP_HTTP_ADDR=:8080
ANYCAP_RUNTIME_MODE=prod
ANYCAP_RATE_LIMIT_RPM=60
ANYCAP_LOGIN_API_KEY_TTL=168h

# Postgres
ANYCAP_PG_HOST=<prod-postgres-host>
ANYCAP_PG_PORT=5432
ANYCAP_PG_USER=<prod-postgres-user>
ANYCAP_PG_PASSWORD=<prod-postgres-password>
ANYCAP_PG_DATABASE=postgres
ANYCAP_PG_SSL_MODE=require
ANYCAP_PG_TIMEZONE=UTC
ANYCAP_PG_AUTO_MIGRATE=false

# Redis
ANYCAP_REDIS_HOST=<prod-redis-host>
ANYCAP_REDIS_PORT=6379
ANYCAP_REDIS_USERNAME=default
ANYCAP_REDIS_PASSWORD=<prod-redis-password>
ANYCAP_REDIS_DB=0

# Auth0
ANYCAP_AUTH0_ENABLED=true
ANYCAP_AUTH0_ISSUER=https://<tenant>.auth0.com/
ANYCAP_AUTH0_AUDIENCE=https://api.anycap.prod
ANYCAP_AUTH0_REDIRECT_URL=https://<your-server-domain>/auth/callback

# Credit
ANYCAP_CREDIT_BASE_URL=<credit-base-url>
ANYCAP_CREDIT_BIZ_TOKEN=<credit-biz-token>
ANYCAP_CREDIT_TIMEOUT_SECONDS=10
ANYCAP_CREDIT_SIGNUP_REWARD_PACKAGE_TYPE=REWARD
ANYCAP_CREDIT_SIGNUP_REWARD_PACKAGE_SUBTYPE=SIGNUP_BONUS
