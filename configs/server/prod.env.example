ANYCAP_APP_NAME=anycap-server
ANYCAP_APP_ENV=prod
ANYCAP_HTTP_ADDR=:8080
ANYCAP_RUNTIME_MODE=prod
ANYCAP_RATE_LIMIT_RPM=60

# Postgres
ANYCAP_PG_HOST=<prod-postgres-host>
ANYCAP_PG_PORT=5432
ANYCAP_PG_USER=<prod-postgres-user>
ANYCAP_PG_PASSWORD=<prod-postgres-password>
ANYCAP_PG_DATABASE=postgres
ANYCAP_PG_SSL_MODE=require
ANYCAP_PG_AUTO_MIGRATE=false

# Redis
ANYCAP_REDIS_HOST=<prod-redis-host>
ANYCAP_REDIS_PORT=6379
ANYCAP_REDIS_USERNAME=default
ANYCAP_REDIS_PASSWORD=<prod-redis-password>
ANYCAP_REDIS_DB=0
