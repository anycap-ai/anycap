ANYCAP_APP_NAME=anycap-server
ANYCAP_APP_ENV=prod
ANYCAP_HTTP_ADDR=:8080
ANYCAP_RUNTIME_MODE=prod
ANYCAP_RATE_LIMIT_RPM=60
ANYCAP_LOGIN_API_KEY_TTL=168h

# Capability rate limit
# Default: all capability-limited function routes use ANYCAP_RATE_LIMIT_RPM.
# Set ANYCAP_RATE_LIMIT_DCONF_ENABLED=true to load rate limits from dconf first.
# When dconf is enabled, AnyCap uses ANYCAP_RATE_LIMIT_DCONF_GROUP / DATA_ID and falls back to env values if dconf init/load fails.
# DCONF_NACOS_HOST / DCONF_NACOS_NAMESPACE are provided by the common-go dconf client environment.
# Override a specific capability with ANYCAP_RATE_LIMIT_<CAPABILITY>_RPM.
# Capability name mapping: image.generate -> ANYCAP_RATE_LIMIT_IMAGE_GENERATE_RPM
# See docs/config/server-rate-limit.md for the full route/capability/env mapping table.
# ANYCAP_RATE_LIMIT_DCONF_ENABLED=false
# ANYCAP_RATE_LIMIT_DCONF_GROUP=anycap
# ANYCAP_RATE_LIMIT_DCONF_DATA_ID=rate_limit
# DCONF_NACOS_HOST=<mse-nacos-host>
# DCONF_NACOS_PORT=8848
# DCONF_NACOS_NAMESPACE=<mse-namespace>
# DCONF_NACOS_CONTEXT_PATH=/nacos
# DCONF_NACOS_TIMEOUT_MS=5000
# ANYCAP_RATE_LIMIT_IMAGE_GENERATE_RPM=10
# ANYCAP_RATE_LIMIT_VIDEO_GENERATE_RPM=5
# ANYCAP_RATE_LIMIT_IMAGE_READ_RPM=30
# ANYCAP_RATE_LIMIT_DRIVE_BROWSE_RPM=120
# ANYCAP_RATE_LIMIT_PAGE_PUBLISH_RPM=12

# Feature access dconf
# Set ANYCAP_FEATURE_DCONF_ENABLED=true to load feature access policy from dconf first.
# When enabled, AnyCap uses ANYCAP_FEATURE_DCONF_GROUP / DATA_ID and falls back to server defaults + ANYCAP_FEATURE_* if dconf init/load fails.
# ANYCAP_FEATURE_DCONF_ENABLED=false
# ANYCAP_FEATURE_DCONF_GROUP=anycap
# ANYCAP_FEATURE_DCONF_DATA_ID=feature_access

# Postgres
ANYCAP_PG_HOST=<prod-postgres-host>
ANYCAP_PG_PORT=5432
ANYCAP_PG_USER=<prod-postgres-user>
ANYCAP_PG_PASSWORD=<prod-postgres-password>
ANYCAP_PG_DATABASE=postgres
ANYCAP_PG_SSL_MODE=require
ANYCAP_PG_TIMEZONE=UTC
ANYCAP_PG_AUTO_MIGRATE=false

# Redis
ANYCAP_REDIS_HOST=<prod-redis-host>
ANYCAP_REDIS_PORT=6379
ANYCAP_REDIS_USERNAME=default
ANYCAP_REDIS_PASSWORD=<prod-redis-password>
ANYCAP_REDIS_DB=0

# Drive/Page shared auth + edge host
ANYCAP_PASSWORD_PEPPER=<strong-random-pepper>
ANYCAP_DRIVE_SHARE_BASE_URL=https://drive.anycap.cloud/s
ANYCAP_DRIVE_ACCESS_TTL_SECONDS=300
ANYCAP_PAGE_HOST_FORMAT=page-%s.anycap.cloud
ANYCAP_PAGE_PREVIEW_HOST_FORMAT=preview-page-%s.anycap.cloud
ANYCAP_PAGE_PREVIEW_TTL_SECONDS=300

# Usage sync (poll NexusHub get_submit_result to backfill final status/cost)
ANYCAP_USAGE_SYNC_ENABLED=true
ANYCAP_USAGE_SYNC_POLL_INTERVAL=1m
ANYCAP_USAGE_SYNC_BATCH_SIZE=50

# Auth0
ANYCAP_AUTH0_ENABLED=true
ANYCAP_AUTH0_ISSUER=https://<tenant>.auth0.com/
ANYCAP_AUTH0_AUDIENCE=https://api.anycap.prod
ANYCAP_AUTH0_REDIRECT_URL=https://<your-server-domain>/auth/callback

# Credit
ANYCAP_CREDIT_BASE_URL=<credit-base-url>
ANYCAP_CREDIT_BIZ_TOKEN=<credit-biz-token>
ANYCAP_CREDIT_TIMEOUT_SECONDS=10
ANYCAP_CREDIT_SIGNUP_REWARD_PACKAGE_TYPE=REWARD
ANYCAP_CREDIT_SIGNUP_REWARD_PACKAGE_SUBTYPE=SIGNUP_BONUS
