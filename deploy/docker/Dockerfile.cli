FROM golang:1.24 AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/anycap ./cmd/anycap

FROM gcr.io/distroless/base-debian12
COPY --from=builder /out/anycap /usr/local/bin/anycap
ENTRYPOINT ["/usr/local/bin/anycap"]
