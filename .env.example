# AnyCap Configuration
# Copy this file to .env in the project root and fill in the values.
# Both server and CLI load this file via godotenv.

# ---------- Core ----------
ANYCAP_APP_NAME=anycap-server
ANYCAP_APP_ENV=local
ANYCAP_HTTP_ADDR=:18080

# ---------- CLI (loaded by CLI via godotenv) ----------
ANYCAP_API_ENDPOINT=http://127.0.0.1:18080

# ---------- NexusHub (catalog + execution) ----------
NEXUSHUB_BASE_URL=http://127.0.0.1:8080
NEXUSHUB_TOKEN=
NEXUSHUB_EXECUTION_BIZ_ID=anycap
NEXUSHUB_EXECUTION_ENTER_FROM=anycap_api
NEXUSHUB_EXECUTION_UID=1

# ---------- Routing defaults ----------
ANYCAP_ROUTE_STRATEGY=priority
ANYCAP_ROUTE_ALLOW_FALLBACK=false
ANYCAP_ROUTE_ENV=
ANYCAP_ROUTE_REGION=
ANYCAP_ROUTE_PROVIDER=
ANYCAP_ROUTE_TIER=

# ---------- Agent Platform (Capabilities Provider) ----------
AGENT_PLATFORM_BASE_URL=https://agent-platform.dev.knoffice.tech
AGENT_PLATFORM_API_KEY=c57cd54f334e0e3469213fe63bddba1166b1a1b3f4240cda332aa5eeca3f6d17
AGENT_PLATFORM_TENANT_ID=anycap
AGENT_PLATFORM_TIMEOUT_SECONDS=120

# ---------- Object Storage (S3-compatible, for presigned uploads) ----------
# Works with Cloudflare R2, AWS S3, MinIO, etc.
S3_ENDPOINT=https://3ad0d55d5adf982237e3d8ea0f2d9842.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=anycap
S3_REGION=auto
S3_PUBLIC_URL=https://cdn.anycap.ai
S3_PRESIGN_EXPIRY_SECONDS=3600
S3_FORCE_PATH_STYLE=true

# ---------- Postgres (CLI; DATABASE_URL overrides if set) ----------
# JSON-encoded connection config for direct DB access from the CLI.
ANYCAP_PG_CONFIG={"Host":"localhost","Port":"5432","User":"anycap","Password":"","DBName":"anycap","SSLMode":"disable","TimeZone":"Asia/Shanghai"}
